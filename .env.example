# Copy to .env and fill in. .env itself is gitignored -- it's only used
# locally by orchestrator.sh to create K8s Secrets and to render image
# references; nothing here ever gets committed or baked into a manifest.

INVENTORY_DB_NAME=movies_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=change_me

BILLING_DB_NAME=billing_db
BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=change_me

RABBITMQ_USER=billing_mq
RABBITMQ_PASSWORD=change_me

# Docker Hub account the app images were pushed to (see README "Building
# and pushing images").
DOCKERHUB_USERNAME=your-dockerhub-username
